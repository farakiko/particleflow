# HTCondor submit for Phase-2 postprocessing (one submission per sample).
# ALWAYS drive this via submit.sh: it passes pp_mode/gen_filter/calo/files_per_job/eos_redir/eos_path
# on the condor_submit command line, and creates the matching eos output subdir.
universe = vanilla
executable = wrapper.sh
arguments  = $(Process) $Fnx(filelist)
getenv     = TRUE

# our postprocessing is self-contained -> ship both variants + the filelist (wrapper picks by PP_MODE)
transfer_input_files = ../postprocessing_run3style.py, ../postprocessing_ticl_ttbar_nopu.py, ../postprocessing_mohamed.py, $(filelist)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

# knobs come from submit.sh via the condor_submit command line. Do NOT add standalone `name = ...`
# lines for pp_mode/gen_filter/calo/files_per_job/eos_redir/eos_path here: condor prepends command-line
# args, so an in-file assignment on a LATER line silently OVERRIDES (clobbers) the submit.sh value —
# that is exactly the bug that wrote output to the default pkl_links instead of the requested EOS_PATH.
# mlpf_venv is the one knob submit.sh does not pass, so it defines its default here.
mlpf_venv   = /afs/cern.ch/work/f/fmokhtar/private/mlpf_env
environment = "FILES_PER_JOB=$(files_per_job) PP_MODE=$(pp_mode) GEN_FILTER=$(gen_filter) CALO=$(calo) MLPF_VENV=$(mlpf_venv) EOS_REDIR=$(eos_redir) EOS_PATH=$(eos_path)"

output = logs/$(sample)_$(Process).out
error  = logs/$(sample)_$(Process).err
log    = logs/$(sample).log
notification = never
+JobFlavour = "workday"

queue $(njobs)
