# HTCondor submit for Run3-style postprocessing (one submission per sample).
# submit.sh fills sample/filelist/njobs/eos_path/calo and creates the eos output subdir.
# Defaults below; override via `condor_submit key=value ... postprocess.sub` or submit.sh.
#   CALO=links is the settled collection (docs/phase2_target_comparison.md); use calo=clue3d for the other variant.
universe = vanilla
executable = wrapper.sh
arguments  = $(Process) $Fnx(filelist)
getenv     = TRUE

# our postprocessing is self-contained -> ship it + the filelist with the job
transfer_input_files = ../postprocessing_run3style.py, $(filelist)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

# knobs (single source of truth = submit.sh, which passes eos_path/calo so mkdir and write-path agree)
calo          = links
files_per_job = 10
mlpf_venv     = /afs/cern.ch/work/f/fmokhtar/private/mlpf_env
eos_redir     = root://eosuser.cern.ch
eos_path      = /eos/user/f/fmokhtar/mlpf/phase2/pkl_links
environment = "FILES_PER_JOB=$(files_per_job) CALO=$(calo) MLPF_VENV=$(mlpf_venv) EOS_REDIR=$(eos_redir) EOS_PATH=$(eos_path)"

output = logs/$(sample)_$(Process).out
error  = logs/$(sample)_$(Process).err
log    = logs/$(sample).log
notification = never
+JobFlavour = "workday"

queue $(njobs)
